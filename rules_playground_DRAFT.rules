// DESIGN ONLY. Paste as an UNPUBLISHED draft in Rules Playground.
// This app has no Firebase Auth flow. Publishing this would block its writes.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function staff() { return request.auth != null && request.auth.uid == 'lab-staff'; }
    function validProduct() {
      return request.resource.data.keys().hasOnly(['name', 'price'])
        && request.resource.data.keys().hasAll(['name', 'price'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('.*[^\\s].*')
        && request.resource.data.name.size() <= 120
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 1000000;
    }
    match /campus_products/{id} {
      allow read: if request.auth != null;
      allow create, update: if staff() && validProduct();
      allow delete: if staff();
    }
  }
}
